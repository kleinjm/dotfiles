#!/usr/bin/env bash
# Prints the base branch of the current branch (e.g. origin/main or main).
# Resolution order:
#   1. Open GitHub PR's baseRefName (via gh, if available)
#   2. Closest merge-base among common base branches, remote or local
#   3. Fallback: origin/main, else main
set -eu

# Echo the first ref that actually exists, preferring the remote copy.
resolve_ref() {
  for candidate in "origin/$1" "$1"; do
    if git rev-parse --verify --quiet "$candidate" >/dev/null 2>&1; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

if command -v gh >/dev/null 2>&1; then
  pr_base=$(gh pr view --json baseRefName -q .baseRefName 2>/dev/null || true)
  if [ -n "${pr_base:-}" ] && resolve_ref "$pr_base"; then
    exit 0
  fi
fi

current=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")

best_branch=""
best_count=""
for name in main master develop trunk; do
  for b in "origin/$name" "$name"; do
    # Don't treat the branch we're on as its own base.
    [ "$b" = "$current" ] && continue
    git rev-parse --verify --quiet "$b" >/dev/null 2>&1 || continue
    mb=$(git merge-base HEAD "$b" 2>/dev/null) || continue
    count=$(git rev-list --count "$mb..HEAD")
    if [ -z "$best_count" ] || [ "$count" -lt "$best_count" ]; then
      best_count=$count
      best_branch=$b
    fi
  done
done

if [ -n "$best_branch" ]; then
  echo "$best_branch"
else
  resolve_ref main || echo "origin/main"
fi
